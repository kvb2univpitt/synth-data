# For the synth worker, located in /app/synth
# Database settings
I2B2_DB_TYPE=postgresql
I2B2_DB_USER=i2b2demodata
I2B2_DB_PASSWORD=demouser
I2B2_DB_URL=i2b2-data-demo
I2B2_DB_NAME=i2b2
I2B2_DB_SCHEMA=public

# Type of I2B2 version to determine what table to pull demographics from (ie. 'upitt')
I2B2_TYPE_DEMOGRAPHICS=upitt

# Celery Redis Configuration
CELERY_BROKER_URL=redis://synth-redis:6379/0
CELERY_BROKER_BACKEND=redis://synth-redis:6379/0
CELERY_QUEUE_NAME=synth
CELERYD_MAX_TASKS_PER_CHILD=8

# CSV Export 
OUTPUT_DIRECTORY=output

# Start-up Resources
STATIC_COMPARISON_PATH=static_variable_values.json

DEBUG_PERFORMANCE=False

# Memory management
# Yield per setting is the number of rows that is retrieved per batch during observation fact query
QUERY_LIMIT=0
OBSERVATION_YIELD_PER=10000

# Random seed for development/testing, leaving commented out as default
# This will make patient and visit generation deterministic.
# RANDOM_SEED=61

# Minimum category count for patient filtering
MIN_CATEGORY_COUNT=10